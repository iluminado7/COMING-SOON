# ==========================================================
#  GoHarv. — Coming Soon  |  .htaccess
#  Sitio 100% estático: index.html + style.css + /img
#  Dominio canónico: https://www.goharv.com.ar
# ==========================================================


# ==========================================================
#  1. FORZAR HTTPS + WWW  (en un solo redirect 301)
# ==========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Nunca redirigir en entorno local (XAMPP no tiene SSL válido)
  RewriteCond %{HTTP_HOST} ^localhost [NC,OR]
  RewriteCond %{HTTP_HOST} ^127\.0\.0\.1 [NC]
  RewriteRule ^ - [L]

  # Si falta HTTPS **o** falta el www -> mandamos a https://www. de una sola vez
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

  # ---- SI USÁS CLOUDFLARE O UN PROXY ----
  # El proxy habla HTTP con tu server, así que %{HTTPS} siempre da "off"
  # y se genera un LOOP INFINITO de redirects.
  # En ese caso: comentá el bloque de arriba y descomentá este:
  #
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  # RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]
</IfModule>


# ==========================================================
#  2. HEADERS DE SEGURIDAD   <-- esto es lo que se había perdido
# ==========================================================
<IfModule mod_headers.c>

  # --- HSTS: obliga HTTPS por 1 año ---
  # ¡ACTIVAR SOLO CUANDO EL SSL YA ESTÉ ANDANDO BIEN!
  # Si lo prendés sin certificado válido, los navegadores te bloquean
  # el sitio por un año y no hay forma rápida de revertirlo.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Evita que el navegador "adivine" el MIME type (previene XSS por MIME sniffing)
  Header always set X-Content-Type-Options "nosniff"

  # Impide que te embeban en un <iframe> (clickjacking / phishing con tu marca)
  Header always set X-Frame-Options "SAMEORIGIN"

  # No filtrar la URL completa a sitios externos
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Apagar APIs del navegador que este sitio no usa
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

  # --- Content Security Policy ---
  # Whitelist exacta de lo que carga la página:
  #   Google Fonts (CSS + .woff2) y Font Awesome (cdnjs).
  #   'unsafe-inline' en style-src es NECESARIO si dejaste el <style> dentro
  #   del index.html. Si pasaste todo el CSS a style.css, podés sacarlo.
  #   script-src 'self': hoy no hay JS propio. Si sumás el countdown, va acá.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

  # No exponer la tecnología del servidor
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>


# ==========================================================
#  3. NO EXPONER ARCHIVOS NI DIRECTORIOS
# ==========================================================

# Apaga el listado de directorios (que /img no muestre el índice de archivos)
Options -Indexes

# Bloquea archivos ocultos y sensibles: .git, .env, .htaccess, backups, etc.
<FilesMatch "^\.|(\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|env|old|orig|save)|~)$">
  Require all denied
</FilesMatch>

# Bloquea explícitamente la carpeta .git (por si subís el repo por FTP sin querer)
RedirectMatch 404 /\.git

# Firma del servidor apagada (no publicar versión de Apache)
ServerSignature Off


# ==========================================================
#  4. SOLO PERMITIR MÉTODOS QUE USA UN SITIO ESTÁTICO
# ==========================================================
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS|POST)$
  RewriteRule .* - [F,L]
</IfModule>


# ==========================================================
#  5. HOTLINK PROTECTION (que no te chupen las imágenes)
# ==========================================================
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?goharv\.com\.ar [NC]
  RewriteRule \.(jpe?g|png|gif|webp|svg|ico)$ - [F,NC,L]
</IfModule>


# ==========================================================
#  6. COMPRESIÓN (performance)
# ==========================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# ==========================================================
#  7. CACHE
# ==========================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # El HTML NO se cachea fuerte: así cuando lances el sitio real,
  # la gente no sigue viendo el "coming soon" viejo.
  ExpiresByType text/html "access plus 0 seconds"

  ExpiresByType text/css "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>


# ==========================================================
#  8. ENCODING + PÁGINA DE ERROR
# ==========================================================
AddDefaultCharset UTF-8
DirectoryIndex index.html

# Mientras es un one-pager, cualquier ruta inexistente va al index.
# Cuando lances el sitio real, cambialo por un 404 propio.
ErrorDocument 404 /index.html
